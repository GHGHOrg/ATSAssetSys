{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(git add *)",
      "Bash(git add *)",
      "PowerShell(git status *)",
      "Bash(git status *)",
      "PowerShell(git diff *)",
      "Bash(git diff *)",
      "PowerShell(git log *)",
      "Bash(git log *)",
      "PowerShell(.\\gradlew.bat :core:assemble :app:assembleDebug *)",
      "PowerShell(.\\gradlew.bat :core:test :app:testDebugUnitTest *)",
      "PowerShell(.\\gradlew.bat :app:lintDebug *)",
      "PowerShell(.\\gradlew.bat spotlessCheck *)",
      "Bash(./gradlew.bat :core:assemble :app:assembleDebug *)",
      "Bash(./gradlew.bat :core:test :app:testDebugUnitTest *)",
      "Bash(./gradlew.bat :app:lintDebug *)",
      "Bash(./gradlew.bat spotlessCheck *)"
    ],
    "ask": [
      "PowerShell(git commit *)",
      "Bash(git commit *)",
      "PowerShell(git merge *)",
      "Bash(git merge *)",
      "PowerShell(git push *)",
      "Bash(git push *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh pr merge *)",
      "WebSearch",
      "WebFetch",
      "PowerShell(Remove-Item *)",
      "Bash(rm *)",
      "PowerShell(git rm *)",
      "Bash(git rm *)",
      "PowerShell(git clean *)",
      "Bash(git clean *)",
      "PowerShell(git reset *)",
      "Bash(git reset *)",
      "PowerShell(git checkout -- *)",
      "Bash(git checkout -- *)",
      "PowerShell(git restore *)",
      "Bash(git restore *)",
      "PowerShell(git branch -D *)",
      "Bash(git branch -D *)",
      "PowerShell(git stash drop *)",
      "Bash(git stash drop *)",
      "PowerShell(Move-Item *)",
      "Bash(mv *)",
      "Edit(spec/spec.md)",
      "Edit(intent/intent.md)"
    ],
    "deny": [
      "Read(keystore.properties)",
      "Read(signing.properties)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
