{
  "$description": "Corporate Design System, sizes, shapes and type for ATS, the same in light and dark (CR7; spec 6, Visual design). W3C design tokens, DTCG 2025.10; px is dp (sp for type) on Android, one to one.",
  "radius": { "$type": "dimension", "default": { "$value": { "value": 8, "unit": "px" } }, "checkbox": { "$value": { "value": 4, "unit": "px" } } },
  "space": { "$type": "dimension", "margin": { "$value": { "value": 12, "unit": "px" }, "$description": "Screen side margin." }, "gap": { "$value": { "value": 8, "unit": "px" }, "$description": "Between cards." }, "inset": { "$value": { "value": 10, "unit": "px" }, "$description": "Inside a card and its rows." }, "touch": { "$value": { "value": 48, "unit": "px" }, "$description": "The smallest touch target." } },
  "icon": { "size": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }, "size-small": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }, "size-dense": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "stroke": { "$type": "number", "$value": 2, "$description": "Lucide's own stroke, kept at every size (D-24)." } },
  "bar": { "$type": "dimension", "height": { "$value": { "value": 72, "unit": "px" }, "$description": "Icon and name on each tab (D-37)." }, "pill-min-width": { "$value": { "value": 84, "unit": "px" }, "$description": "One pill size on every tab (D-37)." }, "pill-padding-top": { "$value": { "value": 6, "unit": "px" } }, "pill-padding-side": { "$value": { "value": 4, "unit": "px" } }, "pill-padding-bottom": { "$value": { "value": 4, "unit": "px" } }, "icon-gap": { "$value": { "value": 2, "unit": "px" }, "$description": "Between a tab's icon and its name." }, "line-width": { "$value": { "value": 24, "unit": "px" }, "$description": "The selected tab's line in dark." }, "line-height": { "$value": { "value": 3, "unit": "px" } }, "line-gap": { "$value": { "value": 3, "unit": "px" }, "$description": "Between the pill and the line." } },
  "button": { "$type": "dimension", "$description": "Three sizes, each filled, outline or text (D-17).", "large-height": { "$value": { "value": 48, "unit": "px" } }, "large-padding": { "$value": { "value": 24, "unit": "px" } }, "medium-height": { "$value": { "value": 40, "unit": "px" } }, "medium-padding": { "$value": { "value": 20, "unit": "px" } }, "small-height": { "$value": { "value": 32, "unit": "px" } }, "small-padding": { "$value": { "value": 12, "unit": "px" } }, "text-padding": { "$value": { "value": 12, "unit": "px" } }, "outline": { "$value": { "value": 1, "unit": "px" } } },
  "field": { "$type": "dimension", "$description": "Text fields, standard and dense (D-16, D-18, D-27, D-28).", "height": { "$value": { "value": 56, "unit": "px" } }, "padding": { "$value": { "value": 12, "unit": "px" } }, "dense-height": { "$value": { "value": 40, "unit": "px" } }, "dense-width": { "$value": { "value": 120, "unit": "px" } }, "dense-padding": { "$value": { "value": 8, "unit": "px" } }, "outline": { "$value": { "value": 1, "unit": "px" } }, "focus-outline": { "$value": { "value": 2, "unit": "px" } }, "mark-size": { "$value": { "value": 20, "unit": "px" } }, "dense-mark-size": { "$value": { "value": 16, "unit": "px" } } },
  "chip": { "$type": "dimension", "height": { "$value": { "value": 32, "unit": "px" } }, "padding": { "$value": { "value": 12, "unit": "px" } }, "gap": { "$value": { "value": 6, "unit": "px" } }, "check-size": { "$value": { "value": 16, "unit": "px" } } },
  "checkbox": { "$type": "dimension", "size": { "$value": { "value": 18, "unit": "px" } }, "outline": { "$value": { "value": 2, "unit": "px" } }, "dense-size": { "$value": { "value": 16, "unit": "px" } }, "dense-outline": { "$value": { "value": 1.5, "unit": "px" } }, "mark-size": { "$value": { "value": 14, "unit": "px" } } },
  "radio": { "$type": "dimension", "size": { "$value": { "value": 20, "unit": "px" } }, "outline": { "$value": { "value": 2, "unit": "px" } }, "dot": { "$value": { "value": 10, "unit": "px" } } },
  "row": { "$type": "dimension", "dense-read-height": { "$value": { "value": 36, "unit": "px" }, "$description": "A dense row that cannot be tapped (D-17)." }, "control-gap": { "$value": { "value": 12, "unit": "px" } } },
  "layer": { "$type": "dimension", "$description": "Dialogs and menus, drawn inside the window (D-34).", "dialog-padding": { "$value": { "value": 16, "unit": "px" } }, "dialog-gap": { "$value": { "value": 12, "unit": "px" } }, "dialog-side": { "$value": { "value": 20, "unit": "px" } }, "menu-width": { "$value": { "value": 196, "unit": "px" } }, "menu-item-padding": { "$value": { "value": 16, "unit": "px" } }, "blocked-outline": { "$value": { "value": 2, "unit": "px" } } },
  "card": { "$type": "dimension", "gap": { "$value": { "value": 4, "unit": "px" }, "$description": "Between lines inside a card." } },
  "band": { "$type": "dimension", "height": { "$value": { "value": 64, "unit": "px" }, "$description": "The title band: 12 above and below a 40 icon (D-08)." }, "side": { "$value": { "value": 4, "unit": "px" } } },
  "opacity": { "$type": "number", "disabled": { "$value": 0.38, "$description": "Anything that cannot be tapped yet (spec 6, Visual design (6))." }, "pressed": { "$value": 0.1 }, "unavailable-lot": { "$value": 0.55, "$description": "A lot that cannot be picked (4.4)." } },
  "font": { "$type": "fontFamily", "asap": { "$value": "Asap" }, "asap-condensed": { "$value": "Asap Condensed" } },
  "type": {
    "screen-title": { "$description": "Screen title. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "big-figure": { "$description": "The summary card's figure (D-13). Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "big-figure-fallback": { "$description": "Used if 32 wraps badly at the largest font (D-13; checked on the phone). Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "section-heading": { "$description": "A section heading; a transaction row's title is body, not this (D-44). Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "body": { "$description": "Body text and row amounts. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 400 } },
    "small": { "$description": "Secondary lines. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 400 } },
    "button": { "$description": "A medium button. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "note": { "$description": "A field's note and a floating label (the New York date note, an original value; D-33). Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 400 } },
    "message": { "$description": "A refused field's message, in the error color (D-16). Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap}" }, "size": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "one-day": { "$description": "The 1-day lines. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap-condensed}" }, "size": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 400 } },
    "tab": { "$description": "Tabs and the bottom bar's names; 700 when selected. Tabular digits for figures.", "family": { "$type": "fontFamily", "$value": "{font.asap-condensed}" }, "size": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }, "line-height": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }, "weight": { "$type": "fontWeight", "$value": 500 } }
  }
}
