<?xml version="1.0" encoding="utf-8"?>
<!-- Setup baseline (spec section 9, criterion 37): exclude all app data from cloud backup and
     device transfer. Generic for now; iteration 02 tightens it against the real database path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>